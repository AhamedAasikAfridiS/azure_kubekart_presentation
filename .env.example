PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# MongoDB or Azure Cosmos DB for MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/kubecart

# Service Bus. Prefer SERVICE_BUS_NAMESPACE with managed identity in Azure.
SERVICE_BUS_NAMESPACE=your-namespace.servicebus.windows.net
SERVICE_BUS_NOTIFICATION_QUEUE=notifications

# Optional local fallback. Do not use a connection string in Azure if managed
# identity is available.
# SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://...

# Local development only. This is ignored inside Azure App Service.
DEV_AUTH_BYPASS=false
DEV_AUTH_ID=local-user-001
DEV_AUTH_EMAIL=developer@example.com
DEV_AUTH_FIRST_NAME=Local
DEV_AUTH_LAST_NAME=Developer
DEV_AUTH_ROLE=admin
