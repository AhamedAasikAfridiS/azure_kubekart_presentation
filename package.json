{
  "name": "kubecart-monolith",
  "version": "2.0.0",
  "private": true,
  "description": "KubeCart monolithic web application for Azure App Service",
  "main": "server.js",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm --prefix Kubecart-frontend ci --include=dev && npm --prefix Kubecart-frontend run build",
    "build:azure": "npm run build",
    "seed:products": "node src/scripts/seedProducts.js"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@azure/service-bus": "^7.9.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
